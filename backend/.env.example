PORT=5000
NODE_ENV=development

# Crawler
MAX_CRAWL_PAGES=15
MAX_CRAWL_DEPTH=2
CRAWL_CONCURRENCY=4
CRAWL_TIMEOUT_MS=15000

# How many scans run in parallel (Puppeteer + Lighthouse are heavy on RAM/CPU)
SCAN_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Phase 3: AI Automation (ALL OPTIONAL)
# ---------------------------------------------------------------------------
# Without any of these, the AI Automation page still works: it uses
# deterministic rules for fixes/analysis and shows honest "not connected"
# states for PR + workflow features.

# LLM provider for tailored fix suggestions: anthropic | openai | none
AI_PROVIDER=none

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- If AI_PROVIDER=openai (also works with Groq/Together/Ollama/LM Studio) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- GitHub: required only for real Pull Request creation + Actions dispatch ---
# A fine-grained personal access token (repo contents + pull-requests: write)
# for the repo below. Configured here on the server only, so connecting a
# repo never triggers an OAuth/authorization prompt in the app itself.
GITHUB_TOKEN=
# The repo you want PRs opened against (your OWN codebase), "owner/name".
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
# Workflow file to dispatch as the CI/CD gate. qa-remediation-ci.yml ships in
# .github/workflows/ and lints+builds both backend and frontend.
GITHUB_WORKFLOW=qa-remediation-ci.yml
